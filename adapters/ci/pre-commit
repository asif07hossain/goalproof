#!/bin/sh
# GoalProof pre-commit check: runs the project's checks before every commit, whichever agent or person wrote the code.
# Install in a project: copy this file to .git/hooks/pre-commit and make it executable (chmod +x .git/hooks/pre-commit).
# It needs goalproof-core.mjs and goalproof-verify.mjs in the project's .goalproof/ folder (see adapters/ci/README.md).
# Note: it checks the working tree, so unstaged changes are included. Skip it once with: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
node "$root/.goalproof/goalproof-verify.mjs" --root "$root" --require-checks
status=$?
if [ "$status" -ne 0 ]; then
  echo "GoalProof: commit stopped. The checks failed, or none are set up (add .goalproof/checks.json)." >&2
fi
exit "$status"
